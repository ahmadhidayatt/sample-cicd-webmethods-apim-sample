
node {
    checkout([
        $class: 'GitSCM',
        branches: [[name: "*/${pipelineConfig.repoBranch}"]],
        userRemoteConfigs: [[
            url: pipelineConfig.repoUrl,
            credentialsId: pipelineConfig.repoCredId
        ]],
        extensions: [[
            $class: 'RelativeTargetDirectory',
            relativeTargetDir: 'apigw-pipeline'
        ]]
    ])
    loadProperties()
    deploy()
    summary()
}
